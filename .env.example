# Remote / Local Ollama Server URL
# Examples:
#   Host Machine Ollama: http://host.docker.internal:11434
#   Remote LAN Ollama:   http://192.168.1.100:11434
#   Custom Domain:       http://ollama.local:11434
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=phi4-mini
OLLAMA_CLOUD_MODEL=gemma4:31b-cloud

# Cron schedule (default: every 5 minutes)
CRON_SCHEDULE="*/5 * * * *"
